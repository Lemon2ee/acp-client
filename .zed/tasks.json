    "args": ["run", "-p", "acp-gui"]
  },
  {
    "label": "acp-gui: claude",
    "command": "cargo",
    "args": ["run", "-p", "acp-gui", "--", "claude"]
  },
  {
    "label": "acp-gui: codex",
    "command": "cargo",
    "args": ["run", "-p", "acp-gui", "--", "codex"]
  },
  {
    "label": "acp-gui: claude + codex, profiled",
    "command": "cargo",
    "args": ["run", "--release", "-p", "acp-gui", "--features", "profile"]
  },
  {
    "label": "acp-cli: claude",
    "command": "cargo",
    "args": ["run", "-p", "acp-cli", "--", "claude"]
  },
  {
    "label": "acp-cli: codex",
    "command": "cargo",
    "args": ["run", "-p", "acp-cli", "--", "codex"]
  },
  {
    "label": "test: acp-gui",
    "command": "cargo",
    "args": ["test", "-p", "acp-gui"]
  },
  {
    "label": "clippy: workspace",
    "command": "cargo",
    "args": ["clippy", "--workspace", "--all-targets"]
  },
  {
    "label": "fmt: workspace",
    "command": "cargo",
    "args": ["fmt", "--all"]
